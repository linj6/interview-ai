# Docker Compose runtime configuration. Replace all empty required values.
# Never use these values as build arguments or frontend configuration.
FRONTEND_PORT=8080
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
AI_DASHSCOPE_API_KEY=
AI_DASHSCOPE_CHAT_MODEL=qwen-plus

# Optional for manual local startup; Compose sets its own internal DB connection.
DB_URL=jdbc:mysql://localhost:3306/interview_agent?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=interview_agent
