<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper
    namespace="com.linj6.interviewagent.candidate.infrastructure.persistence.mapper.CandidateMapper">
    <select id="selectInterviewProfile"
        resultType="com.linj6.interviewagent.candidate.infrastructure.persistence.mapper.CandidateProfileProjection">
        SELECT c.name, r.summary AS resume_summary, r.id AS resume_id
        FROM candidate c JOIN candidate_resume r ON r.candidate_id = c.id
        WHERE c.id = #{candidateId}
    </select>
</mapper>
